<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TravelTracker.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TravelTracker.Web.styles.css" asp-append-version="true" />
</head>
@inject TravelTracker.Web.Data.ApprovalInbox ApprovalInbox
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    string ActiveIf(string page) =>
        string.Equals(currentPage, page, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;

    // Show the Approvals nav link only to users who approve someone (the
    // AppUser.ApproverId relationship, not a role); badge the pending count.
    var isApprover = false;
    var pendingApprovals = 0;
    if (User.Identity?.IsAuthenticated == true)
    {
        var uid = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (uid is not null)
        {
            isApprover = await ApprovalInbox.IsApproverAsync(uid);
            if (isApprover)
                pendingApprovals = await ApprovalInbox.PendingCountAsync(uid);
        }
    }
}
<body>
    <a class="visually-hidden-focusable skip-link" href="#main-content">Skip to main content</a>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3 tt-navbar">
            <div class="container">
                <a class="navbar-brand tt-brand" asp-area="" asp-page="/Index">
                    <span class="tt-brand-mark" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" focusable="false">
                            <path d="M12 2 22 12 12 22 2 12z" />
                        </svg>
                    </span>
                    <span class="tt-brand-text">TravelTracker</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav tt-primary-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link @ActiveIf("/Index")" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link @ActiveIf("/Trips/Index")" asp-area="" asp-page="/Trips/Index">Trips</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @ActiveIf("/Trips/Calendar")" asp-area="" asp-page="/Trips/Calendar">Calendar</a>
                            </li>
                        }
                        @if (isApprover)
                        {
                            <li class="nav-item">
                                <a class="nav-link @ActiveIf("/Trips/Approvals")" asp-area="" asp-page="/Trips/Approvals">
                                    Approvals
                                    @if (pendingApprovals > 0)
                                    {
                                        <span class="badge bg-warning text-dark">@pendingApprovals</span>
                                    }
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Finance") || User.IsInRole("Manager") || User.IsInRole("Arranger") || User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @ActiveIf("/Reports/Index")" asp-area="" asp-page="/Reports/Index">Reports</a>
                            </li>
                        }
                        @if (User.IsInRole("Finance") || User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @ActiveIf("/Reference/CostCenters/Index")" asp-area="" asp-page="/Reference/CostCenters/Index">Cost centers</a>
                            </li>
                        }
                        @if (User.IsInRole("Finance") || User.IsInRole("Manager") || User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @ActiveIf("/Reference/ProjectCodes/Index")" asp-area="" asp-page="/Reference/ProjectCodes/Index">Project codes</a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @ActiveIf("/Admin/Index")" asp-area="" asp-page="/Admin/Index">Admin</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" id="main-content" tabindex="-1" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - TravelTracker.Web - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>