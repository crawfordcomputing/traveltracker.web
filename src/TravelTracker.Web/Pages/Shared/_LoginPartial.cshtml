@using Microsoft.AspNetCore.Identity
@using TravelTracker.Web.Data.Entities
@using TravelTracker.Web.Domain
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@inject IConfiguration Configuration

@if (SignInManager.IsSignedIn(User))
{
    var appUser = await UserManager.GetUserAsync(User);
    var email = appUser?.Email ?? User.Identity?.Name ?? string.Empty;

    // Prefer a real display name ("Aaron Crawford" -> "AC"). Otherwise derive from
    // the email LOCAL PART only (before the @), so the domain never leaks into the
    // initials (e.g. abcrawford79@gmail.com must not become "AG").
    var displayName = !string.IsNullOrWhiteSpace(appUser?.DisplayName)
        ? appUser!.DisplayName
        : email;

    var initialsSource = !string.IsNullOrWhiteSpace(appUser?.DisplayName)
        ? appUser!.DisplayName
        : (email.Contains('@') ? email[..email.IndexOf('@')] : email);

    var parts = initialsSource
        .Split(new[] { ' ', '.', '_', '-', '+' }, StringSplitOptions.RemoveEmptyEntries);

    string initials;
    if (parts.Length >= 2)
    {
        initials = $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}";
    }
    else if (parts.Length == 1)
    {
        var p = parts[0];
        initials = p.Length >= 2
            ? $"{char.ToUpperInvariant(p[0])}{char.ToUpperInvariant(p[1])}"
            : char.ToUpperInvariant(p[0]).ToString();
    }
    else
    {
        initials = "U";
    }

    <ul class="navbar-nav">
        <li class="nav-item dropdown">
            <a class="nav-link tt-account-toggle dropdown-toggle" href="#" id="accountMenu" role="button"
               data-bs-toggle="dropdown" aria-expanded="false">
                <span class="tt-avatar">@initials</span>
                <span class="tt-account-name d-none d-lg-inline">@displayName</span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end tt-account-menu" aria-labelledby="accountMenu">
                <li class="tt-account-header">
                    <span class="tt-account-label">Signed in as</span>
                    <span class="tt-account-email">@email</span>
                </li>
                <li><hr class="dropdown-divider" /></li>
                <li><a class="dropdown-item" asp-page="/Account/Manage/Profile">My profile</a></li>
                <li><a class="dropdown-item" asp-page="/Account/Manage/ChangePassword">Change password</a></li>
                <li><a class="dropdown-item" asp-page="/Account/Manage/TwoFactorAuthentication">Two-factor auth</a></li>
                @if (Configuration.GetValue<bool>("Auth:EnableEntraId"))
                {
                    <li><a class="dropdown-item" asp-page="/Account/Manage/ExternalLogins">External logins</a></li>
                }
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <form method="post" asp-page="/Account/Logout">
                        <button type="submit" class="dropdown-item tt-logout">Log out</button>
                    </form>
                </li>
            </ul>
        </li>
    </ul>
}
else
{
    <ul class="navbar-nav align-items-lg-center">
        @if (RegistrationPolicy.SelfServeAllowed(Configuration))
        {
            <li class="nav-item">
                <a class="nav-link" asp-page="/Account/Register">Register</a>
            </li>
        }
        <li class="nav-item">
            <a class="btn btn-primary btn-sm tt-login-btn" asp-page="/Account/Login">Log in</a>
        </li>
    </ul>
}
