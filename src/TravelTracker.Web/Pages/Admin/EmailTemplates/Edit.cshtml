@page
@model TravelTracker.Web.Pages.Admin.EmailTemplates.EditModel
@using TravelTracker.Web.Data.Entities
@{ ViewData["Title"] = $"Email template: {Model.Spec.Title} ({Model.Audience})"; }

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Admin/Index">Admin</a></li>
        <li class="breadcrumb-item"><a asp-page="Index">Email templates</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Spec.Title</li>
    </ol>
</nav>

<h1 class="h3 mb-1">@Model.Spec.Title</h1>
<p class="text-muted mb-2">@Model.Spec.Description</p>

<ul class="nav nav-pills mb-3">
    @foreach (var a in new[] { EmailAudience.Any, EmailAudience.Internal, EmailAudience.External })
    {
        <li class="nav-item">
            <a class="nav-link py-1 @(a == Model.Audience ? "active" : "")"
               asp-page="Edit" asp-route-key="@Model.Key" asp-route-audience="@a">@a</a>
        </li>
    }
</ul>

@if (TempData["TemplateInfo"] is string info)
{
    <div class="alert alert-success alert-dismissible fade show" role="status">
        @info
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<p class="small">
    @if (Model.Existing is not null)
    {
        <span class="badge bg-primary">Customized</span>
        <span class="text-muted">
            Last edited @Model.Existing.UpdatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC
            @if (!string.IsNullOrEmpty(Model.UpdatedByName)) { <span>by @Model.UpdatedByName</span> }
        </span>
    }
    else
    {
        <span class="badge bg-light text-dark border">Not customized</span>
        <span class="text-muted">@Model.Audience recipients currently get @Model.InheritsFrom. Saving creates an override.</span>
    }
</p>

<div class="row g-4">
    <div class="col-lg-7">
        <form method="post" id="template-form" asp-page-handler="Save"
              asp-route-key="@Model.Key" asp-route-audience="@Model.Audience">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.Subject" class="form-label"></label>
                <input asp-for="Input.Subject" class="form-control" data-token-target maxlength="256" />
            </div>

            <div class="mb-2">
                <label asp-for="Input.HtmlBody" class="form-label"></label>
                <textarea asp-for="Input.HtmlBody" class="form-control font-monospace" rows="14"
                          data-token-target spellcheck="false"></textarea>
                <div class="form-text">
                    HTML is allowed. Scripts, iframes, event handlers and <code>javascript:</code> links are removed on save.
                    Token values are always HTML-encoded.
                </div>
            </div>

            <div class="mb-3">
                <div class="small fw-semibold mb-1">Tokens <span class="fw-normal text-muted">(click to insert at the cursor)</span></div>
                <div class="d-flex flex-wrap gap-1">
                    @foreach (var t in Model.Spec.Allowed)
                    {
                        var required = Model.Spec.Required.Contains(t);
                        <button type="button" class="btn btn-sm @(required ? "btn-outline-primary" : "btn-outline-secondary") font-monospace"
                                data-insert-token="{{@t}}"
                                title="@(required ? "Required" : "Optional")">{{@t}}@(required ? " *" : "")</button>
                    }
                </div>
                <div class="form-text">* required. <code>{{CommentBlock}}</code> renders <code>&lt;p&gt;Comment: ...&lt;/p&gt;</code> only when there is a comment.</div>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <button type="submit" class="btn btn-outline-secondary" asp-page-handler="SendTest"
                        asp-route-key="@Model.Key" asp-route-audience="@Model.Audience">Send test to me</button>
                <a asp-page="Index" class="btn btn-link">Cancel</a>
            </div>
        </form>

        @if (Model.Existing is not null)
        {
            <form method="post" asp-page-handler="Reset" asp-route-key="@Model.Key" asp-route-audience="@Model.Audience"
                  class="mt-3" onsubmit="return confirm('Delete this override and go back to @(Model.Audience == EmailAudience.Any ? "the built-in default" : "the Any variant or built-in default")?');">
                <button type="submit" class="btn btn-sm btn-outline-danger">Reset to default</button>
            </form>
        }
    </div>

    <div class="col-lg-5">
        <h2 class="h6">Preview <span class="text-muted fw-normal small">(sample data)</span></h2>
        <div class="border rounded">
            <div class="px-2 py-1 border-bottom small bg-light">
                <span class="text-muted">Subject:</span> <span id="preview-subject">@Model.Preview?.Subject</span>
            </div>
            @* sandbox with no allowances: no scripts, forms, popups or same-origin access. *@
            <iframe id="preview-frame" sandbox title="Email preview"
                    srcdoc="@(Model.Preview?.HtmlBody ?? "")"
                    style="width:100%; height:22rem; border:0; background:#fff;"></iframe>
        </div>
        <ul id="preview-errors" class="small text-danger mt-2 mb-0 ps-3">
            @foreach (var e in Model.PreviewErrors) { <li>@e</li> }
        </ul>

        <div class="card mt-4">
            <div class="card-body">
                <h2 class="h6">Which audience is an address?</h2>
                <form method="get" class="d-flex gap-2">
                    <input type="hidden" name="key" value="@Model.Key" />
                    <input type="hidden" name="audience" value="@Model.Audience" />
                    <input name="checkEmail" value="@Model.CheckEmail" class="form-control form-control-sm"
                           placeholder="someone@example.com" aria-label="Email address to classify" />
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Check</button>
                </form>
                @if (Model.CheckResult is not null)
                {
                    <p class="small mt-2 mb-0">
                        <code>@Model.CheckEmail</code> is <strong>@Model.CheckResult</strong>.
                        @if (Model.CheckResult == EmailAudience.Any)
                        {
                            <span class="text-muted">No internal domains are configured.</span>
                        }
                    </p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/email-template-editor.js" asp-append-version="true"></script>
}
