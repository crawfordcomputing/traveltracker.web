@page
@model TravelTracker.Web.Pages.Reference.CostCenters.IndexModel
@{ ViewData["Title"] = "Cost centers"; }

<div class="row"><div class="col-lg-8">
<h1 class="h3 mb-3">Cost centers</h1>
<p class="text-muted">Managed by Finance and Admins. Inactive codes stay linked to existing trips but are hidden from pickers.</p>

<form method="post" asp-page-handler="Create" class="mb-4">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-2 align-items-start">
        <div class="col-sm-4">
            <label asp-for="NewCode" class="form-label"></label>
            <input asp-for="NewCode" class="form-control" placeholder="e.g. ENG-100" />
            <span asp-validation-for="NewCode" class="text-danger"></span>
        </div>
        <div class="col-sm-6">
            <label asp-for="NewName" class="form-label"></label>
            <input asp-for="NewName" class="form-control" placeholder="e.g. Engineering — Platform" />
            <span asp-validation-for="NewName" class="text-danger"></span>
        </div>
        <div class="col-sm-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">Add</button>
        </div>
    </div>
</form>

@if (Model.CostCenters.Count == 0)
{
    <div class="alert alert-info">No cost centers yet. Add the first one above.</div>
}
else
{
    <table class="table table-sm align-middle">
        <caption class="visually-hidden">Cost centers</caption>
        <thead>
            <tr><th scope="col">Code</th><th scope="col">Name</th><th scope="col">Status</th><th scope="col" class="text-end">Actions</th></tr>
        </thead>
        <tbody>
        @foreach (var c in Model.CostCenters)
        {
            <tr>
                <td><code>@c.Code</code></td>
                <td>@(c.Name ?? "—")</td>
                <td>
                    @if (c.IsActive)
                    { <span class="badge bg-success">Active</span> }
                    else
                    { <span class="badge bg-secondary">Inactive</span> }
                </td>
                <td class="text-end">
                    <form method="post" asp-page-handler="Toggle" asp-route-id="@c.Id" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                            @(c.IsActive ? "Deactivate" : "Reactivate")
                        </button>
                    </form>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@c.Id"
                          onsubmit="return confirm('Delete @c.Code? Trips using it will keep their history but lose the link.');" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
