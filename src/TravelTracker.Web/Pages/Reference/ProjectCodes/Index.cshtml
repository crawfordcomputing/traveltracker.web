@page
@model TravelTracker.Web.Pages.Reference.ProjectCodes.IndexModel
@{ ViewData["Title"] = "Project codes"; }

<div class="row"><div class="col-lg-8">
<h1 class="h3 mb-3">Project codes</h1>
<p class="text-muted">Managed by Finance, Managers, and Admins. Inactive codes stay linked to existing trips but are hidden from pickers.</p>

<form method="post" asp-page-handler="Create" class="mb-4">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-2 align-items-start">
        <div class="col-sm-4">
            <label asp-for="NewCode" class="form-label"></label>
            <input asp-for="NewCode" class="form-control" placeholder="e.g. PRJ-2026-04" />
            <span asp-validation-for="NewCode" class="text-danger"></span>
        </div>
        <div class="col-sm-6">
            <label asp-for="NewName" class="form-label"></label>
            <input asp-for="NewName" class="form-control" placeholder="e.g. Q2 Field Rollout" />
            <span asp-validation-for="NewName" class="text-danger"></span>
        </div>
        <div class="col-sm-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">Add</button>
        </div>
    </div>
</form>

@if (Model.ProjectCodes.Count == 0)
{
    <div class="alert alert-info">No project codes yet. Add the first one above.</div>
}
else
{
    <table class="table table-sm align-middle">
        <thead>
            <tr><th scope="col">Code</th><th scope="col">Name</th><th scope="col">Status</th><th scope="col" class="text-end">Actions</th></tr>
        </thead>
        <tbody>
        @foreach (var p in Model.ProjectCodes)
        {
            <tr>
                <td><code>@p.Code</code></td>
                <td>@(p.Name ?? "—")</td>
                <td>
                    @if (p.IsActive)
                    { <span class="badge bg-success">Active</span> }
                    else
                    { <span class="badge bg-secondary">Inactive</span> }
                </td>
                <td class="text-end">
                    <form method="post" asp-page-handler="Toggle" asp-route-id="@p.Id" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                            @(p.IsActive ? "Deactivate" : "Reactivate")
                        </button>
                    </form>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@p.Id"
                          onsubmit="return confirm('Delete @p.Code? Trips using it will keep their history but lose the link.');" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
