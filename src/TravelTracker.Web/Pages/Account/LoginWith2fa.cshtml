@page
@model TravelTracker.Web.Pages.Account.LoginWith2faModel
@{ ViewData["Title"] = "Two-factor sign-in"; }

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="h3 mb-3">Two-factor sign-in</h1>
        <p class="text-muted">Enter the code from your authenticator app.</p>

        <form method="post" asp-route-returnUrl="@Model.ReturnUrl" asp-route-rememberMe="@Model.RememberMe">
            <div asp-validation-summary="All" class="text-danger mb-2"></div>
            <div class="mb-3">
                <label asp-for="Input.TwoFactorCode" class="form-label"></label>
                <input asp-for="Input.TwoFactorCode" class="form-control" autocomplete="one-time-code"
                       inputmode="numeric" placeholder="123456" autofocus />
                <span asp-validation-for="Input.TwoFactorCode" class="text-danger"></span>
            </div>
            <div class="form-check mb-3">
                <input asp-for="Input.RememberMachine" class="form-check-input" />
                <label asp-for="Input.RememberMachine" class="form-check-label"></label>
            </div>
            <button type="submit" class="btn btn-primary">Sign in</button>
        </form>

        <p class="mt-3">
            Lost your authenticator app?
            <a asp-page="./LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl">Use a recovery code</a>.
        </p>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
