@page
@model TravelTracker.Web.Pages.Account.Manage.Disable2faModel
@{ ViewData["Title"] = "Disable 2FA"; }

<div class="row justify-content-center">
    <div class="col-md-6">
        <h1 class="h3 mb-3">Disable two-factor authentication</h1>

        <div class="alert alert-warning">
            This removes the second sign-in factor from your account. You can set up an
            authenticator app again at any time.
        </div>

        <form method="post">
            <button type="submit" class="btn btn-danger">Disable 2FA</button>
            <a class="btn btn-link" asp-page="./TwoFactorAuthentication">Cancel</a>
        </form>
    </div>
</div>
