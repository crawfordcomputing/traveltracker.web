@page
@model TravelTracker.Web.Pages.Account.RegisterConfirmationModel
@{ ViewData["Title"] = "Confirm your email"; }

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="h3 mb-3">Almost there</h1>
        <div class="alert alert-info">
            We've sent a confirmation link to
            <strong>@(string.IsNullOrWhiteSpace(Model.Email) ? "your email address" : Model.Email)</strong>.
            Click the link to activate your account, then sign in. In development the
            link is written to the app console.
        </div>
        <a asp-page="/Account/ResendEmailConfirmation" class="btn btn-link px-0">Didn't get it? Resend</a>
    </div>
</div>
