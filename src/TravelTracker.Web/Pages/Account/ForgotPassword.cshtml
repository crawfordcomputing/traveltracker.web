@page
@model TravelTracker.Web.Pages.Account.ForgotPasswordModel
@{ ViewData["Title"] = "Forgot password"; }

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="h3 mb-3">Forgot your password?</h1>

        @if (Model.Submitted)
        {
            <div class="alert alert-success">
                If an account exists for that email, we've sent a link to reset the
                password. Check your inbox (and the app console in development).
            </div>
            <a asp-page="/Account/Login" class="btn btn-link px-0">Back to sign in</a>
        }
        else
        {
            <p class="text-muted">Enter your email and we'll send you a reset link.</p>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label"></label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary">Send reset link</button>
                <a asp-page="/Account/Login" class="btn btn-link">Back to sign in</a>
            </form>
        }
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
