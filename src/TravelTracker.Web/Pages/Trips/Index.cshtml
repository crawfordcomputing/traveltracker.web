@page
@using TravelTracker.Web.Data.Entities
@model TravelTracker.Web.Pages.Trips.IndexModel
@{ ViewData["Title"] = Model.ShowTraveler ? "Trips" : "My trips"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@ViewData["Title"]</h1>
    <div>
        @if (Model.CanSeeTeamRoster)
        {
            <a asp-page="WhoIsOut" class="btn btn-outline-secondary">Who's out</a>
        }
        <a asp-page="Calendar" class="btn btn-outline-secondary">Calendar view</a>
        <a asp-page="Create" class="btn btn-primary">New trip</a>
    </div>
</div>

<ul class="nav nav-pills mb-3">
    @foreach (var (key, label) in new[] { ("upcoming", "Upcoming"), ("past", "Past"), ("all", "All") })
    {
        <li class="nav-item">
            <a class="nav-link @(Model.When == key ? "active" : "")"
               asp-route-When="@key" asp-route-TravelerId="@Model.TravelerId"
               asp-route-Status="@Model.Status" asp-route-Search="@Model.Search">@label</a>
        </li>
    }
</ul>

<form method="get" class="row g-2 align-items-end mb-3">
    <input type="hidden" name="When" value="@Model.When" />
    @if (Model.ShowTraveler)
    {
        <div class="col-auto">
            <label class="form-label" for="TravelerId">Traveler</label>
            <select id="TravelerId" name="TravelerId" asp-items="Model.TravelerFilter" class="form-select">
                <option value="">— everyone —</option>
            </select>
        </div>
    }
    <div class="col-auto">
        <label class="form-label" for="Status">Status</label>
        <select id="Status" name="Status" asp-items="Html.GetEnumSelectList<TripStatus>()" class="form-select">
            <option value="">— any —</option>
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label" for="From">From</label>
        <input type="date" id="From" name="From" value="@(Model.From?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label" for="To">To</label>
        <input type="date" id="To" name="To" value="@(Model.To?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label" for="Search">Search</label>
        <input type="text" id="Search" name="Search" value="@Model.Search" placeholder="purpose, city, or trip code" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filter</button>
        <a asp-page="Index" asp-route-When="@Model.When" class="btn btn-link">Reset</a>
    </div>
</form>

@if (Model.Trips.Count == 0)
{
    <div class="alert alert-light border">No trips match. <a asp-page="Create">Create one.</a></div>
}
else
{
    <table class="table table-striped align-middle">
        <caption class="visually-hidden">@ViewData["Title"]</caption>
        <thead>
            <tr>
                <th scope="col">Code</th>
                <th scope="col">Purpose</th>
                @if (Model.ShowTraveler) { <th scope="col">Traveler</th> }
                <th scope="col">Dates</th>
                <th scope="col">Legs</th>
                <th scope="col">Status</th>
                <th scope="col"><span class="visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var t in Model.Trips)
        {
            <tr>
                <td class="text-nowrap"><code>@t.Code</code></td>
                <td><a asp-page="Details" asp-route-id="@t.Id">@t.Purpose</a></td>
                @if (Model.ShowTraveler) { <td>@(t.Traveler?.DisplayName ?? "—")</td> }
                <td>@t.StartDate.ToString("MMM d") &ndash; @t.EndDate.ToString("MMM d, yyyy")</td>
                <td>@t.Destinations.Count</td>
                <td><partial name="_StatusBadge" model="t.Status" /></td>
                <td class="text-end text-nowrap">
                    <a asp-page="Details" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">Open</a>
                    <form method="post" asp-page-handler="Clone" asp-route-id="@t.Id" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Clone</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>

    @if (Model.TotalPages > 1)
    {
        <nav>
            <ul class="pagination">
                <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-route-PageNumber="@(Model.PageNumber - 1)"
                       asp-route-When="@Model.When" asp-route-TravelerId="@Model.TravelerId"
                       asp-route-Status="@Model.Status" asp-route-From="@(Model.From?.ToString("yyyy-MM-dd"))"
                       asp-route-To="@(Model.To?.ToString("yyyy-MM-dd"))" asp-route-Search="@Model.Search">Previous</a>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">Page @Model.PageNumber of @Model.TotalPages</span>
                </li>
                <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-route-PageNumber="@(Model.PageNumber + 1)"
                       asp-route-When="@Model.When" asp-route-TravelerId="@Model.TravelerId"
                       asp-route-Status="@Model.Status" asp-route-From="@(Model.From?.ToString("yyyy-MM-dd"))"
                       asp-route-To="@(Model.To?.ToString("yyyy-MM-dd"))" asp-route-Search="@Model.Search">Next</a>
                </li>
            </ul>
        </nav>
    }
}
